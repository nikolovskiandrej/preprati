# preprati. — configuration
#
# Copy to `.env` (or set real environment variables in your platform) and adjust.
# Everything below has a sensible default; only uncomment what you need.
# Sizes accept units (512MiB, 1GB); durations accept s/m/h/d (10m, 24h, 7d).
#
# Never commit real secrets. TURN and S3 credentials are read by the server
# only — they are never embedded in the frontend bundle.

# ─────────────────────────────── Server ────────────────────────────────
# NODE_ENV=production
# HOST=0.0.0.0                    # default: 127.0.0.1 in development, 0.0.0.0 in production
# PORT=8787
# PUBLIC_ORIGIN=https://preprati.example   # your public https origin (CORS/WebSocket origin check, CSP, HSTS)
# ALLOWED_ORIGINS=                # extra origins allowed to call the API (only if the frontend is hosted elsewhere)
# TRUST_PROXY=false               # true | <number of hops> | comma-separated proxy IPs — set when behind a reverse proxy
# SERVE_STATIC=true               # serve the built frontend from STATIC_DIR (default: true in production)
# STATIC_DIR=dist/client
# LOG_LEVEL=info                  # fatal | error | warn | info | debug | silent

# Attribution link for "Made by Notea" (plain text when unset).
# NOTEA_URL=

# ─────────────────────── Quick Transfer (WebRTC) ───────────────────────
# STUN helps devices on different networks find a direct path. Set to empty to disable.
# STUN_URLS=stun:stun.l.google.com:19302

# TURN relays traffic when no direct path exists (strict NATs, some mobile networks).
# Preferred: coturn with `use-auth-secret` / `static-auth-secret` → short-lived credentials.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=change-me
# TURN_CREDENTIAL_TTL=6h
# Alternative (less safe, long-lived): static credentials handed to session participants.
# TURN_USERNAME=
# TURN_CREDENTIAL=

# SESSION_PAIRING_TTL=10m         # how long a code/QR stays valid while waiting for a device
# SESSION_MAX_LIFETIME=12h        # hard upper bound for a signaling session
# SESSION_MAX_TOTAL=5000
# SESSION_MAX_PER_IP=10
# WS_MAX_CONNECTIONS_PER_IP=20
# WS_MAX_MESSAGE_SIZE=64KiB
# WS_HEARTBEAT_INTERVAL=30s

# ──────────────────────── Share Files (storage) ────────────────────────
# Hosted sharing stores only client-side-encrypted data. In production you must
# choose a storage driver explicitly; without one, Share Files stays disabled
# and the interface says so.
# SHARE_ENABLED=true
# STORAGE_DRIVER=local            # local | s3 | vercel-blob   (default: local in development, unset in production)

# local: a persistent directory (mount a volume in containers!)
# STORAGE_DIR=data/shares

# s3: any S3-compatible object storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO, SeaweedFS…)
# S3_BUCKET=preprati-shares
# S3_REGION=us-east-1             # use "auto" for Cloudflare R2
# S3_ENDPOINT=                    # e.g. https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false       # true for MinIO/SeaweedFS
# S3_PREFIX=preprati/

# vercel-blob: a PRIVATE Vercel Blob store (connect it to the project; Vercel sets the token)
# BLOB_READ_WRITE_TOKEN=          # set automatically when the store is connected
# BLOB_PREFIX=preprati/
# BLOB_MONTHLY_WRITE_BUDGET=0     # cap on uploads' write operations per month (0 = no cap); see docs/DEPLOYMENT.md

# SHARE_TTL=24h                   # how long a share link works
# SHARE_MAX_FILE_SIZE=1GB
# SHARE_MAX_PACKAGE_SIZE=1GB
# SHARE_MAX_FILES=100
# SHARE_STORAGE_QUOTA=20GB        # total encrypted bytes kept at once
# SHARE_MAX_ACTIVE=2000           # active shares at once
# SHARE_CHUNK_SIZE=4MiB           # plaintext bytes per encrypted chunk (64KiB–16MiB)
# SHARE_UPLOAD_TIMEOUT=2h         # deadline to finish an upload; abandoned uploads are removed
# SHARE_REQUEST_TIMEOUT=2m        # per-request timeout for uploads/downloads
# SHARE_TOMBSTONE_TTL=7d          # how long "expired"/"deleted" is remembered (no file data is kept)
# CLEANUP_INTERVAL=5m

# ───────────────────────────── Rate limits ─────────────────────────────
# RATE_LIMIT_API=900              # API requests per IP per minute
# RATE_LIMIT_SHARE_CREATE=30      # new shares per IP per hour
# RATE_LIMIT_WS_CONNECT=30        # signaling connections per IP per minute
# RATE_LIMIT_JOIN_FAILURES=20     # wrong codes/links per IP per 10 minutes
# RATE_LIMIT_WS_MESSAGES=300      # signaling messages per connection per 10 seconds

# ─────────────────────── Frontend (build time) ─────────────────────────
# Only needed when the frontend is served from a different origin than the API.
# These are public values baked into the bundle — never put secrets here.
# VITE_API_BASE_URL=https://api.preprati.example
# VITE_SIGNALING_URL=wss://api.preprati.example/ws

# ─────────────────────── Serverless (e.g. Vercel) ──────────────────────
# Long-lived servers need none of this. On serverless platforms, instances are
# short-lived and don't share memory: signaling switches to HTTP polling and
# all shared state (signaling sessions, share metadata, quotas) lives in Redis.
# SERVERLESS=false                # default: true when VERCEL=1
# SIGNALING_TRANSPORT=websocket   # websocket | http   (default: http when serverless)
# KV_DRIVER=                      # memory | upstash   (default: upstash when the URL/token below are set, else memory)
# KV_REST_API_URL=                # Upstash Redis REST URL (set by the Vercel ↔ Upstash integration)
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=         # accepted as an alternative name
# UPSTASH_REDIS_REST_TOKEN=
# CRON_SECRET=                    # protects GET /api/cron/cleanup (Vercel Cron sends it as a Bearer token)
